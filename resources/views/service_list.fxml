<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.ServiceListController"
            prefWidth="700" prefHeight="400">

<top>
        <ToolBar>
            <Button text="Back" onAction="#onBack"/>
            <Label text="Available Services" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </ToolBar>
    </top>

    <center>
        <TableView fx:id="serviceTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Service"/>
                <TableColumn fx:id="priceColumn" text="Price"/>
                <TableColumn fx:id="durationColumn" text="Duration (min)"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" padding="10">
            <Button text="Book Selected" onAction="#onBookSelected"/>
        </HBox>
    </bottom>
</BorderPane>
