<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.ManageStaffController"
            prefWidth="800" prefHeight="450">

    <top>
        <ToolBar>
            <Button text="Back" onAction="#onBack"/>
            <Label text="Manage Staff"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </ToolBar>
    </top>

    <center>
        <SplitPane>
            <TableView fx:id="staffTable" prefWidth="500">
                <columns>
                    <TableColumn fx:id="nameColumn" text="Name"/>
                    <TableColumn fx:id="specializationColumn" text="Specialization"/>
                    <TableColumn fx:id="phoneColumn" text="Phone"/>
                </columns>
            </TableView>

            <VBox spacing="10" padding="10">
                <TextField fx:id="nameField" promptText="Name"/>
                <TextField fx:id="specializationField" promptText="Specialization"/>
                <TextField fx:id="phoneField" promptText="Phone"/>
                <HBox spacing="10">
                    <Button text="Add" onAction="#onAdd"/>
                    <Button text="Update" onAction="#onUpdate"/>
                    <Button text="Delete" onAction="#onDelete"/>
                </HBox>
                <Label fx:id="errorLabel" textFill="red" wrapText="true"/>
            </VBox>
        </SplitPane>
    </center>
</BorderPane>
