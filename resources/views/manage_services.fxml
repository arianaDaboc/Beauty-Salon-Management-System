<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.ManageServicesController"
            prefWidth="900" prefHeight="550">
    <top>
        <ToolBar>
            <Button text="Back" onAction="#onBack"/>
            <Label text="Manage Services"
                   style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-padding: 0 0 0 20;" />
        </ToolBar>
    </top>
    <center>
        <TableView fx:id="serviceTable">
            <columns>
                <TableColumn fx:id="nameColumn" text="Name" prefWidth="200"/>
                <TableColumn fx:id="priceColumn" text="Price" prefWidth="100"/>
                <TableColumn fx:id="durationColumn" text="Duration (min)" prefWidth="120"/>
                <TableColumn fx:id="categoryColumn" text="Category ID" prefWidth="120"/>
            </columns>
        </TableView>
    </center>
    <bottom>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>
            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints halignment="RIGHT" minWidth="120"/>
                    <ColumnConstraints halignment="LEFT" minWidth="200"/>
                </columnConstraints>
                <Label text="Name:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                <Label text="Price:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="priceField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>


                <Label text="Duration (min):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="durationField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>


                <Label text="Category:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <ComboBox fx:id="categoryCombo" prefWidth="200"
                          GridPane.rowIndex="3" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Add" prefWidth="100" onAction="#onAdd"/>
                <Button text="Update" prefWidth="100" onAction="#onUpdate"/>
                <Button text="Delete" prefWidth="100" onAction="#onDelete"/>
            </HBox>


            <Label fx:id="errorLabel" textFill="red" style="-fx-font-size: 14;" />
        </VBox>
    </bottom>

</BorderPane>
