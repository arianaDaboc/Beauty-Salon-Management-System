<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.CustomerHomeController"
            prefWidth="600" prefHeight="400">

    <top>
        <Label text="Customer Home"
               style="-fx-font-size: 22px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox alignment="CENTER" spacing="10">
            <Label fx:id="welcomeLabel"/>
            <Button text="View Services" onAction="#onViewServices"/>
            <Button text="Book Appointment" onAction="#onBookAppointment"/>
            <Button text="My Appointments" onAction="#onMyAppointments"/>
            <Button text="Logout" onAction="#onLogout"/>
            <Label fx:id="errorLabel" textFill="red"/>
        </VBox>
    </center>
</BorderPane>
