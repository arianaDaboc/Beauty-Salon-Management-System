<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.DatePicker?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ui.controllers.BookAppointmentController"
            prefWidth="500" prefHeight="400">

    <top>
        <ToolBar>
            <Button text="Back" onAction="#onBack"/>
            <Label text="Book Appointment" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        </ToolBar>
    </top>

    <center>
        <VBox spacing="10" alignment="CENTER" padding="20">
            <ComboBox fx:id="serviceCombo" promptText="Select Service" prefWidth="250"/>
            <ComboBox fx:id="staffCombo" promptText="Select Staff" prefWidth="250"/>
            <DatePicker fx:id="datePicker"/>
            <TextField fx:id="timeField" promptText="Time (HH:MM)"/>
            <Button text="Book" onAction="#onBook"/>
            <Label fx:id="errorLabel" textFill="red" wrapText="true"/>
        </VBox>
    </center>
</BorderPane>
